# Copy to .env and fill in. Placeholders only: never commit real keys.

# --- server ---
SIA_ADMIN_KEY=change-me                 # needed to create organizations and change plans over HTTP
SIA_DB=sia.db                           # SQLite file (one server instance; see README "Limitations")
SIA_RATE_LIMIT=120                      # requests per organization per minute, 0 = off
SIA_MAX_BODY_BYTES=4194304              # larger request bodies get 413
# SIA_DEFAULT_LLM_KEY=                  # managed agents only: server-side Gemini key for requests without X-LLM-Key
# SIA_ALLOW_CUSTOM_BASE_URL=1           # self-hosted only: allow X-LLM-Base-URL and Ollama (off prevents SSRF)

# --- SDK / CLI ---
# SIA_API_KEY=sia_...                   # set for hosted mode; leave unset for local mode
# SIA_BASE_URL=https://sia.example.com
# SIA_PROJECT=my-ai-agent
# SIA_LOCAL_DB=sia_local.db

# --- model keys (only for the demos and `sia improve`) ---
GENAI_API_KEY=your-gemini-key
# SIA_LLM_KEY=                          # key for `sia improve --provider ...` (falls back to GENAI_API_KEY)
