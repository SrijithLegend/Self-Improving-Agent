# Copy to .env and fill in. Placeholders only: never commit real keys.

# --- server ---
# needed to create organizations and change plans over HTTP. 32+ random characters, or the admin API stays off:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIA_ADMIN_KEY=
SIA_DB=sia.db                           # SQLite file (one server instance; see README "Limitations")
SIA_RATE_LIMIT=120                      # requests per organization per minute, 0 = off
SIA_IP_RATE_LIMIT=600                   # requests per client IP per minute, 0 = off
SIA_AUTH_FAIL_LIMIT=20                  # invalid keys per IP per 10 minutes, then 429
SIA_LLM_CONCURRENCY_PER_ORG=2           # model-calling requests at once per organization
SIA_LLM_CONCURRENCY=16                  # ...and in total
SIA_MAX_BODY_BYTES=4194304              # larger request bodies get 413
# SIA_TRUSTED_PROXIES=127.0.0.1         # your reverse proxy / load balancer address(es)
# SIA_ALLOWED_HOSTS=api.example.com     # other Host headers get 400
SIA_CONTACT_EMAIL=                      # public contact address (pages link to it); empty = GitHub issues
# SIA_DEFAULT_LLM_KEY=                  # managed agents only: server-side Gemini key for requests without X-LLM-Key
# SIA_ALLOW_CUSTOM_BASE_URL=1           # self-hosted only: allow X-LLM-Base-URL and Ollama (off prevents SSRF)

# --- payments (Razorpay; use test-mode keys rzp_test_... until you go live) ---
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx      # set the same secret on the webhook in the Razorpay dashboard
# SIA_PRICE_PRO_PAISE=199900            # placeholder prices, in paise, per 30 days
# SIA_PRICE_TEAM_PAISE=799900
# SIA_CURRENCY=INR

# --- SDK / CLI ---
# SIA_API_KEY=sia_...                   # set for hosted mode; leave unset for local mode
# SIA_BASE_URL=https://sia.example.com
# SIA_PROJECT=my-ai-agent
# SIA_LOCAL_DB=sia_local.db

# --- model keys (only for the demos and `sia improve`) ---
GENAI_API_KEY=your-gemini-key
# SIA_LLM_KEY=                          # key for `sia improve --provider ...` (falls back to GENAI_API_KEY)
